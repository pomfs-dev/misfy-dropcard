    {
      "name": "5. PayPal deposit (Orders v2 + webhook)",
      "item": [
        {
          "name": "5.1 Create the deposit order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{depositKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/deposit-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{bookingId}}",
                "deposit-order"
              ]
            },
            "description": "Creates the PayPal order (30% deposit). The Idempotency-Key is reused on purpose: sending this again returns the same PayPal order."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('depositKey')) pm.collectionVariables.set('depositKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('paypalOrderId', d.paypal_order_id);",
                  "console.log('Approve as the sandbox buyer: https://www.sandbox.paypal.com/checkoutnow?token=' + d.paypal_order_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 (browser) Approve as the sandbox buyer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://www.sandbox.paypal.com/checkoutnow?token={{paypalOrderId}}",
              "protocol": "https",
              "host": [
                "www",
                "sandbox",
                "paypal",
                "com"
              ],
              "path": [
                "checkoutnow"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{paypalOrderId}}"
                }
              ]
            },
            "description": "Open this URL in a browser and log in with the PayPal sandbox buyer account from the README/testing instructions, then approve. (In the web app, the PayPal button does this step.)"
          }
        },
        {
          "name": "5.3 Capture",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paypal/orders/{{paypalOrderId}}/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paypal",
                "orders",
                "{{paypalOrderId}}",
                "capture"
              ]
            },
            "description": "Asks PayPal to capture. Returns 'pending_webhook': the booking is confirmed only when the verified PAYMENT.CAPTURE.COMPLETED webhook arrives."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Booking status (poll until paid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{bookingId}}"
              ]
            },
            "description": "Repeat until status is 'paid'. deposit_order.confirmed_by tells whether the webhook or the reconciliation job confirmed it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json(); console.log(d.status, d.deposit_order && d.deposit_order.confirmed_by);"
                ]
              }
            }
          ]
        }
      ]
    },
