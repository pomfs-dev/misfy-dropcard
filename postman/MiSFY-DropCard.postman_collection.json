{
  "info": {
    "name": "MiSFY DropCard — PayPal + AI booking flow",
    "_postman_id": "6f0f3c1e-5b7a-4c1e-9d1a-dc0000000001",
    "description": "Reproduce the full flow against a running MiSFY DropCard server: AI venue scout (Claude: search venues, check dates, send the proposal) → venue approval → PayPal Orders v2 deposit (confirmed by webhook) → tickets → demo clock → PayPal Payouts settlement → ledger-based dashboard.\n\nSet `baseUrl` to the hosted demo or to http://localhost:8080. Postman keeps the `dc_sid` cookie, which is your demo session. Run the folders in order. One step needs a browser: approving the PayPal payment as the sandbox buyer (see '5.2').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "venueSlug",
      "value": "blue-lantern"
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "paypalOrderId",
      "value": ""
    },
    {
      "key": "ticketOrderId",
      "value": ""
    },
    {
      "key": "depositKey",
      "value": ""
    },
    {
      "key": "ticketKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Demo session",
      "item": [
        {
          "name": "1.1 Get my demo session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            },
            "description": "Creates the demo session cookie on first call and returns the session's 'now' (real time + demo clock offset)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Reset my demo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/demo/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "reset"
              ]
            },
            "description": "Deletes this session's bookings and conversations and resets the demo clock. Shared sample data is untouched."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('conversationId', ''); pm.collectionVariables.set('bookingId', ''); pm.collectionVariables.set('depositKey', ''); pm.collectionVariables.set('ticketKey', '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Venue",
      "item": [
        {
          "name": "2.1 Venue card",
          "request": {
            "method": "GET",
            "header": [],
