    },
    {
      "name": "3. AI venue scout (Claude)",
      "item": [
        {
          "name": "3.1 Ask the scout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "chat"
              ]
            },
            "description": "Claude checks availability with tools and proposes up to 3 slots (status ai_proposed). Stores the conversation id and the first proposal as bookingId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artist\": \"hollow-arcade\",\n  \"message\": \"The busiest venues in Seoul for a synthwave show, about 300 people. Check dates at the best fit for a Friday in the next few weeks.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('conversationId', d.conversation_id);",
                  "if (d.proposals && d.proposals.length) { pm.collectionVariables.set('bookingId', d.proposals[0].id); pm.collectionVariables.set('venueSlug', d.proposals[0].venue_slug); }",
                  "pm.test('the scout searched the venue directory', () => pm.expect(d.tool_calls.map(t => t.name)).to.include('search_venues'));",
                  "pm.test('venues came back ranked by activity', () => pm.expect(d.venues.map(v => v.activity)).to.eql([...d.venues.map(v => v.activity)].sort((a, b) => b - a)));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Send the proposal for the first slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "chat"
              ]
            },
            "description": "Asks the agent to send the request for the first proposal (request_booking → hold).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversationId}}\",\n  \"message\": \"Send the proposal for the first option please. We need a DJ booth.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json();",
                  "if (d.booking) { pm.collectionVariables.set('bookingId', d.booking.id); pm.collectionVariables.set('venueSlug', d.booking.venue_slug); }",
                  "pm.test('the proposal was sent (hold)', () => pm.expect(d.booking && d.booking.status).to.eql('hold'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Try to pay before approval (blocked)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "chat"
              ]
            },
            "description": "The agent's create_deposit_order tool is refused by the server until the venue approves; the refusal shows up as a 'blocked' tool call.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversationId}}\",\n  \"message\": \"Can I pay the deposit now?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json();",
                  "pm.test('payment tool blocked before approval', () => pm.expect(d.tool_calls.map(t => t.status)).to.include('blocked'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3b (no LLM key) Request the proposal directly",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{bookingId}}",
                "request"
              ]
            },
            "description": "Use this instead of 3.1–3.3 when the server has no LLM key: same as the agent's request_booking (proposal → hold). If the agent already sent the request, this answers 409, which is fine.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inquiry_text\": \"Synthwave night, about 300 guests.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('requested (or already requested by the agent)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ],
      "description": "The scout works for one artist (hollow-arcade). It searches the venue directory ranked by activity, checks dates at the best fit, proposes slots and sends the proposal it writes. The tests store the booking's venue in venueSlug for the owner steps that follow."
    },
