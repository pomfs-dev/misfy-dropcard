# Copy to .env and fill in. Never commit real values.

# Postgres (14+, needs the btree_gist extension that ships with standard builds)
DATABASE_URL=postgres://dropcard@127.0.0.1:55432/dropcard
PORT=8080
# Built frontend (cd web && npm install && npm run build)
WEB_DIR=web/dist
# Set to 1 when the site is served over HTTPS (e.g. on Render)
COOKIE_SECURE=0
# Background jobs (settlement, payouts, reconciliation) in the web process
RUN_JOBS=1

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id of the sandbox app's webhook pointing at https://<your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal sandbox receiver accounts used for payouts (personal sandbox accounts)
SANDBOX_VENUE_EMAIL=
SANDBOX_ARTIST_EMAIL=
SANDBOX_PROMOTER_EMAIL=

# AI venue scout (Anthropic Claude API); without a key the scout is off and venue cards use the booking form
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Abuse protection for the public demo: agent turns per day across all visitors
LLM_DAILY_TURN_CAP=50
# Optional: load the venue directory from a file kept out of the repository (see scripts/venue_directory.py)
VENUE_DIRECTORY_CSV=
