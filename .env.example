# 복사해서 .env 로 쓴다. 실제 값은 저장소에 올리지 않는다.
DATABASE_URL=postgres://dropcard@127.0.0.1:55432/dropcard
PORT=8080
# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# LLM (AI 대관 상담)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
